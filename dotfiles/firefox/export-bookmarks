#!/usr/bin/env python3
# dotfiles/firefox/export-bookmarks — Gucixdev
#
# Firefox already keeps its own rolling bookmark backups in the profile's
# bookmarkbackups/ dir, compressed as .jsonlz4 (an 8-byte "mozLz40\0" magic + a
# 4-byte little-endian uncompressed size + a raw, unframed LZ4 block). This decodes
# that block itself instead of adding the `lz4` pip package as a dependency for one
# file format: picks the newest backup, decompresses it, writes plain pretty-printed
# JSON to bookmarks.json next to this script so it's actually diffable in git.
#
# Run by hand whenever bookmarks are worth re-snapshotting; not on a timer.

import json
import sys
from pathlib import Path

MOZLZ4_MAGIC = b"mozLz40\0"


def lz4_block_decompress(data: bytes) -> bytes:
    out = bytearray()
    i, n = 0, len(data)
    while i < n:
        token = data[i]
        i += 1
        lit_len = token >> 4
        if lit_len == 15:
            while True:
                b = data[i]
                i += 1
                lit_len += b
                if b != 255:
                    break
        out += data[i : i + lit_len]
        i += lit_len
        if i >= n:
            break
        offset = data[i] | (data[i + 1] << 8)
        i += 2
        match_len = (token & 0xF) + 4
        if (token & 0xF) == 15:
            while True:
                b = data[i]
                i += 1
                match_len += b
                if b != 255:
                    break
        start = len(out) - offset
        for j in range(match_len):
            out.append(out[start + j])
    return bytes(out)


def find_profile() -> Path:
    roots = [
        Path.home() / ".mozilla/firefox",
        Path.home() / ".config/mozilla/firefox",
        Path.home() / ".var/app/org.mozilla.firefox/.mozilla/firefox",
    ]
    for root in roots:
        ini = root / "profiles.ini"
        if not ini.exists():
            continue
        best, best_mtime = None, -1
        for backups_dir in root.glob("*/bookmarkbackups"):
            if not any(backups_dir.iterdir()):
                continue
            m = backups_dir.stat().st_mtime
            if m > best_mtime:
                best, best_mtime = backups_dir.parent, m
        if best is not None:
            return best
    sys.exit("No Firefox profile with bookmark backups found under ~/.mozilla, ~/.config/mozilla or the flatpak path.")


def main():
    profile = find_profile()
    backups = sorted((profile / "bookmarkbackups").glob("*.jsonlz4"), key=lambda p: p.stat().st_mtime)
    if not backups:
        sys.exit(f"No .jsonlz4 backups in {profile / 'bookmarkbackups'}")
    latest = backups[-1]

    raw = latest.read_bytes()
    if not raw.startswith(MOZLZ4_MAGIC):
        sys.exit(f"{latest} doesn't start with the mozLz40 magic — unexpected format")
    payload = raw[len(MOZLZ4_MAGIC) + 4 :]  # skip magic + 4-byte uncompressed-size header
    decompressed = lz4_block_decompress(payload)
    data = json.loads(decompressed)

    out_path = Path(__file__).parent / "bookmarks.json"
    out_path.write_text(json.dumps(data, indent=2, ensure_ascii=False, sort_keys=True))
    print(f"{latest.name} -> {out_path}")


if __name__ == "__main__":
    main()

#!/bin/sh
# gap-filling pseudo-fs mounts; every one guarded so re-runs / an initramfs
# that already did the work are both fine.
m() { mountpoint -q "$2" 2>/dev/null || mount -t "$1" "$3" "$2" "$4" 2>/dev/null; }
mkdir -p /proc /sys /dev /run 2>/dev/null
m proc     /proc     proc     "-o nosuid,noexec,nodev"
m sysfs    /sys      sysfs    "-o nosuid,noexec,nodev"
m devtmpfs /dev      dev      "-o mode=0755,nosuid"
m tmpfs    /run      run      "-o mode=0755,nosuid,nodev"
mkdir -p /run/lock /dev/pts /dev/shm /dev/mqueue 2>/dev/null
m devpts   /dev/pts  devpts   "-o mode=0620,gid=5,nosuid,noexec"
m tmpfs    /dev/shm  shm      "-o mode=1777,nosuid,nodev"
m mqueue   /dev/mqueue mqueue "-o nosuid,noexec,nodev"
m tmpfs    /run/lock  lock    "-o mode=1777,nosuid,nodev,size=5m"
# cgroup v2 (best effort; ignored if the kernel/uapi disagrees)
mkdir -p /sys/fs/cgroup 2>/dev/null
m cgroup2  /sys/fs/cgroup cgroup2 "-o nsdelegate"
exit 0

#!/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin; export PATH
command -v modprobe >/dev/null 2>&1 || exit 0
# virtio safety nets (all usually built-in on gentoo-dist -> modprobe no-ops)
for m in virtio_pci virtio_net virtio_blk virtio_scsi 9pnet_virtio; do
	modprobe -q "$m" 2>/dev/null
done
for d in /etc/modules-load.d /run/modules-load.d /usr/lib/modules-load.d; do
	[ -d "$d" ] || continue
	for f in "$d"/*.conf; do
		[ -r "$f" ] || continue
		while read -r line; do
			case "$line" in ''|'#'*|';'*) continue;; esac
			modprobe -q "$line" 2>/dev/null
		done < "$f"
	done
done
exit 0

#!/usr/bin/env bash
#set and forget uruchamiany przez systemd dziala gdy system bezczynni i nie ma wplywu na performance ani nie w trakcie waznej pracy
#kazdy task ma swojego stampa zeby nie sprawdzac tego zbyt czesto
#uruchamia przez systemd co godzine albo po uruchomieniu systemu
#balans pomiedzy zaleznosciami a hardcoded

# Najniższy priorytet — zero wpływu na performance
if [[ $EUID -ne 0 ]]; then
    exec sudo "$(readlink -f "$0")" "$@"
fi

if [[ -z "$_MAINT_NICED" ]]; then
    export _MAINT_NICED=1
    exec nice -n 19 ionice -c 3 "$(readlink -f "$0")" "$@"
fi

# ═══════════════════════════════════════════════════════
# config
# ═══════════════════════════════════════════════════════

MIN=60; HOUR=3600; DAY=86400; WEEK=604800; MONTH=2592000; YEAR=31536000
KB=1024; MB=1048576; GB=1073741824; TB=1099511627776

BUSY_PROCS=(
    "gamescope" "steam_app_" "wine" "proton" "lutris" "chrome" "chromium"
    "blender" "kdenlive" "davinci" "obs" "resolve" "steam" "firefox" "krita" "gimp"
)
NOTIFY_USER="drbongo"
LOG_FILE="/var/log/maintanance.log"
STATE_DIR="/var/lib/maintanance"
LOG_MAX_BYTES=$(( 5 * MB ))
AFK_MIN_SECONDS=$(( 5 * MIN ))
MAX_LOAD=2.5
SCANNED_BUSYPROCS=()

BTRFS_MOUNTS=("/" "/data")    # nadpisywane przez scan
SMART_DISKS=("/dev/sda")      # nadpisywane przez scan
COUNTRY=                       # nadpisywane przez scan
DISK_WARN_PERCENT=80
SNAPSHOT_CMD='snap(){ btrfs subvolume snapshot -r / "/snapshots/$(date +%Y-%m-%d_%H%M%S)-${1}"; }; snap'
                                # brak snappera na tym systemie - gole btrfs subvolume
                                # snapshot (read-only) pod /snapshots/, ten sam wzorzec
                                # co juz istniejacy /snapshots/2026-09-26_153701
BACKUP_CMD=""                  # np. "restic -r /mnt/backup backup $HOME"

FREQ_TIME_SYNC=$(( 6 * HOUR ))
FREQ_MIRRORS=$(( 1 * WEEK ))
FREQ_UPDATE=$(( 1 * WEEK ))
FREQ_CLEAN_CACHE=$(( 3 * DAY ))
FREQ_CLEAN_BROWSERS=$(( 1 * WEEK ))
FREQ_CLEAN_ORPHANS=$(( 1 * WEEK ))
FREQ_CLEAN_TMP=$(( 6 * HOUR ))
FREQ_CLEAN_LOGS=$(( 1 * WEEK ))
FREQ_BTRFS_BALANCE=$(( 2 * WEEK ))
FREQ_BTRFS_SCRUB=$(( 1 * MONTH ))
FREQ_DISK_SPACE=$(( 6 * HOUR ))
FREQ_BACKUP=$(( 1 * DAY ))
FREQ_SMART=$(( 1 * WEEK ))
FREQ_SCAN=$(( 1 * MONTH ))
FREQ_NMAP=$(( 1 * WEEK ))
FREQ_RKHUNTER=$(( 1 * WEEK ))

# ═══════════════════════════════════════════════════════
# internal — nie edytuj poniżej
# ═══════════════════════════════════════════════════════

SCAN_FILE="$STATE_DIR/scan.env"
ERR_FILE=""
BGPIDS=()

USER_UID=$(id -u "$NOTIFY_USER" 2>/dev/null || echo 1000)
DBUS="unix:path=/run/user/${USER_UID}/bus"

_log() { printf '[%s] [%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" "${*:2}" >> "$LOG_FILE"; }
log()  { _log "INFO " "$*"; }
warn() { _log "WARN " "$*"; echo "$*" >> "$ERR_FILE"; }

notify() {
    local urgency="${1:-normal}"; shift
    DBUS_SESSION_BUS_ADDRESS="$DBUS" \
    sudo -u "$NOTIFY_USER" \
    notify-send --urgency="$urgency" --app-name="maintanance" "🔧 maintanance" "$*" 2>/dev/null || true
}

run() {
    local desc="$1"; shift
    log "RUN: $desc"
    "$@" >> "$LOG_FILE" 2>&1
    local rc=$?
    [[ $rc -ne 0 ]] && warn "FAIL($rc): $desc"
    return $rc
}

bg()      { "$@" & BGPIDS+=($!); }
bg_wait() {
    local pid rc=0
    for pid in "${BGPIDS[@]}"; do
        wait "$pid"; local r; r=$?
        [[ $r -ne 0 ]] && rc=$r
    done
    BGPIDS=()
    return $rc
}

has()         { command -v "$1" &>/dev/null; }
has_network() { [[ "${_NETWORK:-0}" -eq 1 ]]; }

rotate_log() {
    [[ -f "$LOG_FILE" ]] || return 0
    local size; size=$(stat -c%s "$LOG_FILE" 2>/dev/null || echo 0)
    [[ "$size" -gt "$LOG_MAX_BYTES" ]] && mv "$LOG_FILE" "${LOG_FILE}.1" && gzip -f "${LOG_FILE}.1"
}

get_idle_seconds() {
    local session idle_us now_us
    session=$(loginctl list-sessions --no-legend 2>/dev/null | awk 'NR==1{print $1}')
    idle_us=$(loginctl show-session "$session" --property=IdleSinceHint --value 2>/dev/null || echo 0)
    if [[ "$idle_us" -gt 0 ]]; then
        now_us=$(date +%s%6N)
        echo $(( (now_us - idle_us) / 1000000 ))
        return
    fi
    local last now
    last=$(find /dev/input/event* -maxdepth 0 -printf '%T@\n' 2>/dev/null | sort -rn | head -1 | cut -d. -f1)
    now=$(date +%s)
    [[ -n "$last" ]] && echo $(( now - last )) || echo 9999
}

is_afk()  { local idle; idle=$(get_idle_seconds); [[ "$idle" -ge "$AFK_MIN_SECONDS" ]]; }

is_busy() {
    local all_procs=("${BUSY_PROCS[@]}" "${SCANNED_BUSYPROCS[@]}")
    for proc in "${all_procs[@]}"; do pgrep -f "$proc" &>/dev/null && return 0; done
    local load; load=$(awk '{print $1}' /proc/loadavg)
    awk -v l="$load" -v m="$MAX_LOAD" 'BEGIN { exit (l >= m ? 0 : 1) }' && return 0
    return 1
}

due()       {
    local task="$1" freq_sec="$2"
    local f="$STATE_DIR/$task"
    [[ ! -f "$f" ]] && return 0
    local elapsed; elapsed=$(( $(date +%s) - $(<"$f") ))
    [[ "$elapsed" -ge "$freq_sec" ]]
}
mark_done() { date +%s > "$STATE_DIR/$1"; }

# ═══════════════════════════════════════════════════════
# #updater
# ═══════════════════════════════════════════════════════

task_time_sync() {
    due time_sync "$FREQ_TIME_SYNC" || return 0
    has_network || { log "time_sync: brak sieci — pomijam"; return 0; }
    log "=== TIME SYNC ==="
    run "ntp enable"        timedatectl set-ntp true
    run "timesyncd restart" systemctl restart systemd-timesyncd
    mark_done time_sync
}

task_mirrors() {
    due mirrors "$FREQ_MIRRORS" || return 0
    has reflector || { log "reflector: brak — pomijam"; return 0; }
    has_network   || { log "mirrors: brak sieci — pomijam"; return 0; }
    log "=== MIRRORS ==="
    local country_arg=""
    [[ -n "$COUNTRY" ]] && country_arg="--country $COUNTRY"
    # shellcheck disable=SC2086
    run "reflector" reflector $country_arg --protocol https --sort rate --latest 20 --save /etc/pacman.d/mirrorlist
    mark_done mirrors
}

task_update() {
    due update "$FREQ_UPDATE" || return 0
    has_network || { log "update: brak sieci — pomijam"; return 0; }
    log "=== UPDATE ==="

    local kernel_before; kernel_before=$(uname -r)

    [[ -n "$SNAPSHOT_CMD" ]] && run "snapshot pre" bash -c "$SNAPSHOT_CMD 'pre-update'"

    run "pacman-key refresh" pacman-key --refresh-keys
    run "pacman -Syu"        pacman -Syu --noconfirm

    local aur="${AUR_HELPER:-}"
    [[ -z "$aur" ]] && has paru && aur="paru"
    [[ -z "$aur" ]] && has yay  && aur="yay"
    [[ -n "$aur" ]] && run "$aur -Syu" sudo -u "$NOTIFY_USER" "$aur" -Syu --noconfirm --noprogressbar

    has flatpak   && run "flatpak update"  flatpak update -y
    has fwupdmgr  && { run "fwupd refresh" fwupdmgr refresh --force
                       run "fwupd update"  fwupdmgr update -y; }
    has pacdiff   && run "pacdiff"         bash -c "DIFFPROG='diff -u' pacdiff --noconfirm >> '$LOG_FILE' 2>&1 || true"
    has mandb     && run "mandb"           mandb --quiet
    has fc-cache  && run "fc-cache"        fc-cache -f
    has needrestart && run "needrestart"   needrestart -r a

    [[ -n "$SNAPSHOT_CMD" ]] && run "snapshot post" bash -c "$SNAPSHOT_CMD 'post-update'"

    local kernel_after; kernel_after=$(pacman -Q linux 2>/dev/null | awk '{print $2}' || echo "")
    if [[ -n "$kernel_after" ]] && [[ "$kernel_before" != *"${kernel_after%%-*}"* ]]; then
        notify normal "Kernel zaktualizowany (${kernel_before} → ${kernel_after}) — wymagany restart"
    fi

    mark_done update
}

task_backup() {
    [[ -z "$BACKUP_CMD" ]] && return 0
    due backup "$FREQ_BACKUP" || return 0
    has_network || { log "backup: brak sieci — pomijam"; return 0; }
    log "=== BACKUP ==="
    run "backup" bash -c "$BACKUP_CMD"
    mark_done backup
}

# ═══════════════════════════════════════════════════════
# #cleaner
# ═══════════════════════════════════════════════════════

task_disk_space() {
    due disk_space "$FREQ_DISK_SPACE" || return 0
    log "=== DISK SPACE ==="
    local alerted=0
    while read -r pct mp; do
        if [[ "$pct" -ge "$DISK_WARN_PERCENT" ]]; then
            warn "Dysk ${mp}: ${pct}% zajęte!"
            alerted=1
        fi
    done < <(df --output=pcent,target -x tmpfs -x devtmpfs 2>/dev/null | tail -n +2 | tr -d ' %')
    [[ $alerted -eq 1 ]] && notify critical "Mało miejsca na dysku — sprawdź log!"
    mark_done disk_space
}

task_clean_cache() {
    due clean_cache "$FREQ_CLEAN_CACHE" || return 0
    log "=== CLEAN CACHE ==="
    has paccache && run "paccache" paccache -rk2
    local aur="${AUR_HELPER:-}"
    [[ -z "$aur" ]] && has paru && aur="paru"
    [[ -z "$aur" ]] && has yay  && aur="yay"
    [[ -n "$aur" ]] && has "$aur" && run "$aur cache" "$aur" -Sc --noconfirm --noprogressbar 2>/dev/null || true
    has flatpak && run "flatpak unused" flatpak uninstall --unused -y
    local cache="/home/$NOTIFY_USER/.cache"
    find "$cache/thumbnails"        -type f -atime +30 -print0 2>/dev/null | xargs -0 --no-run-if-empty rm -f >> "$LOG_FILE" 2>&1
    find "$cache" -name "*.log"     -mtime +7  -print0 2>/dev/null | xargs -0 --no-run-if-empty rm -f >> "$LOG_FILE" 2>&1
    find "$cache/mesa_shader_cache" -type f -atime +14 -print0 2>/dev/null | xargs -0 --no-run-if-empty rm -f >> "$LOG_FILE" 2>&1
    find "$cache/nvidia"            -type f -atime +14 -print0 2>/dev/null | xargs -0 --no-run-if-empty rm -f >> "$LOG_FILE" 2>&1
    find "$cache/hyprland"          -type f -atime +7  -print0 2>/dev/null | xargs -0 --no-run-if-empty rm -f >> "$LOG_FILE" 2>&1
    has systemd-resolve && run "DNS flush" systemd-resolve --flush-caches
    mark_done clean_cache
}

task_clean_browsers() {
    due clean_browsers "$FREQ_CLEAN_BROWSERS" || return 0
    log "=== CLEAN BROWSERS ==="
    local profile
    for profile in \
        "/home/$NOTIFY_USER/.mozilla/firefox/"*.default*/ \
        "/home/$NOTIFY_USER/.config/mozilla/firefox/"*.default*/ \
        "/home/$NOTIFY_USER/.var/app/org.mozilla.firefox/.mozilla/firefox/"*.default*/; do
        [[ -d "$profile" ]] || continue
        find "$profile/cache2"       -type f -atime +7 -print0 2>/dev/null | xargs -0 --no-run-if-empty rm -f >> "$LOG_FILE" 2>&1
        find "$profile/crashreports" -type f -mtime +7 -print0 2>/dev/null | xargs -0 --no-run-if-empty rm -f >> "$LOG_FILE" 2>&1
    done
    for browser_dir in \
        "/home/$NOTIFY_USER/.config/chromium/Default" \
        "/home/$NOTIFY_USER/.config/google-chrome/Default" \
        "/home/$NOTIFY_USER/.config/BraveSoftware/Brave-Browser/Default"; do
        [[ -d "$browser_dir/Cache" ]] || continue
        find "$browser_dir/Cache" -type f -atime +7 -print0 2>/dev/null | xargs -0 --no-run-if-empty rm -f >> "$LOG_FILE" 2>&1
    done
    mark_done clean_browsers
}

task_clean_orphans() {
    due clean_orphans "$FREQ_CLEAN_ORPHANS" || return 0
    log "=== CLEAN ORPHANS ==="
    local orphans; orphans=$(pacman -Qtdq 2>/dev/null || true)
    if [[ -n "$orphans" ]]; then
        log "Usuwam: $(echo "$orphans" | tr '\n' ' ')"
        echo "$orphans" | xargs pacman -Rns --noconfirm -- >> "$LOG_FILE" 2>&1
        local rc=$?
        [[ $rc -ne 0 ]] && warn "orphans: błąd usuwania ($rc)"
    else
        log "Brak osieroconych pakietów"
    fi
    mark_done clean_orphans
}

task_clean_tmp() {
    due clean_tmp "$FREQ_CLEAN_TMP" || return 0
    log "=== CLEAN TMP ==="
    find /tmp -maxdepth 1 -mtime +1 -print0 2>/dev/null | xargs -0 --no-run-if-empty rm -rf >> "$LOG_FILE" 2>&1
    mark_done clean_tmp
}

task_clean_logs() {
    due clean_logs "$FREQ_CLEAN_LOGS" || return 0
    log "=== CLEAN LOGS ==="
    run "journald time" journalctl --vacuum-time=2weeks
    run "journald size" journalctl --vacuum-size=500M
    mark_done clean_logs
}

task_btrfs_balance() {
    due btrfs_balance "$FREQ_BTRFS_BALANCE" || return 0
    log "=== BTRFS BALANCE ==="
    for mount in "${BTRFS_MOUNTS[@]}"; do
        run "balance $mount" btrfs balance start -dusage=85 -musage=85 "$mount" || true
    done
    mark_done btrfs_balance
}

task_btrfs_scrub() {
    due btrfs_scrub "$FREQ_BTRFS_SCRUB" || return 0
    log "=== BTRFS SCRUB ==="
    for mount in "${BTRFS_MOUNTS[@]}"; do
        run "scrub $mount" btrfs scrub start -B "$mount" || true
    done
    mark_done btrfs_scrub
}

# ═══════════════════════════════════════════════════════
# #tester
# ═══════════════════════════════════════════════════════

task_smart() {
    due smart "$FREQ_SMART" || return 0
    has smartctl || { log "smartctl: brak — pomijam"; return 0; }
    log "=== SMART ==="
    for disk in "${SMART_DISKS[@]}"; do
        [[ -b "$disk" ]] || continue
        local out rc
        out=$(smartctl -H "$disk" 2>&1); rc=$?
        printf '%s\n' "$out" >> "$LOG_FILE"
        echo "$out" | grep -qE "PASSED|OK" || warn "SMART: problem na $disk! (rc=$rc)"
    done
    mark_done smart
}

# ═══════════════════════════════════════════════════════
# #security
# ═══════════════════════════════════════════════════════

task_nmap() {
    due nmap "$FREQ_NMAP" || return 0
    has nmap || { log "nmap: brak — pomijam"; return 0; }
    log "=== NMAP (lokalna siec) ==="

    local subnet
    subnet=$(ip -4 route list scope link 2>/dev/null | awk '{print $1; exit}')
    [[ -z "$subnet" ]] && { warn "nmap: nie wykryto lokalnej podsieci — pomijam"; return 0; }

    local hosts_file="$STATE_DIR/nmap-hosts.txt"
    local out new_hosts
    out=$(nmap -sn "$subnet" 2>/dev/null | awk '/^Nmap scan report/{gsub(/[()]/,"",$NF); print $NF}')
    printf '%s\n' "$out" >> "$LOG_FILE"

    if [[ -f "$hosts_file" ]]; then
        new_hosts=$(comm -13 <(sort "$hosts_file") <(echo "$out" | sort))
        [[ -n "$new_hosts" ]] && warn "nmap: nowe urzadzenia w sieci: $new_hosts" \
            && notify critical "Nowe urzadzenia w sieci lokalnej: $new_hosts"
    fi
    echo "$out" > "$hosts_file"
    mark_done nmap
}

task_rkhunter() {
    due rkhunter "$FREQ_RKHUNTER" || return 0
    has rkhunter || { log "rkhunter: brak — pomijam"; return 0; }
    log "=== RKHUNTER ==="

    local out warnings
    out=$(rkhunter --cronjob 2>&1)   # implies -c --sk --nocolors
    printf '%s\n' "$out" >> "$LOG_FILE"

    warnings=$(echo "$out" | grep -c "Warning:")
    if [[ "$warnings" -gt 0 ]]; then
        warn "rkhunter: $warnings ostrzezen — zobacz $LOG_FILE"
        notify critical "rkhunter znalazl $warnings ostrzezen — sprawdz log"
    fi
    mark_done rkhunter
}

# ═══════════════════════════════════════════════════════
# #scanner
# ═══════════════════════════════════════════════════════

task_scan() {
    due scan "$FREQ_SCAN" || [[ ! -f "$SCAN_FILE" ]] || return 0
    log "=== SCAN ==="

    has fastfetch || { warn "scan: fastfetch brak — paru -S fastfetch"; return 0; }
    has jq        || { warn "scan: jq brak — paru -S jq"; return 0; }

    local ff
    ff=$(fastfetch --structure "OS:CPU:Memory:GPU:Disk:PhysicalDisk" --format json 2>/dev/null)

    local _parsed
    _parsed=$(jq -r '
        (map(select(.type=="OS"))[0].result     // {}) as $os  |
        (map(select(.type=="CPU"))[0].result    // {}) as $cpu |
        (map(select(.type=="Memory"))[0].result // {}) as $mem |
        (map(select(.type=="GPU"))[0].result[0] // {}) as $gpu |
        [
            ($os.id                              // ""),
            ($os.prettyName                      // ""),
            ($cpu.cpu                            // ""),
            (($cpu.cores.logical // 0)           | tostring),
            ($cpu.march                          // ""),
            (($cpu.frequency.max // 0)           | tostring),
            (($mem.total // 0) / 1024 / 1024 | floor | tostring),
            ($gpu.vendor // "unknown"            | ascii_downcase),
            ($gpu.name   // "unknown"),
            ($gpu.driver // "")
        ] | join("\n")
    ' <<< "$ff")

    local distro_id distro_name cpu_model cpu_cores cpu_arch cpu_freq_max ram_total_mb gpu_vendor gpu_name gpu_driver
    mapfile -t _vals <<< "$_parsed"
    distro_id="${_vals[0]}"  distro_name="${_vals[1]}"
    cpu_model="${_vals[2]}"  cpu_cores="${_vals[3]}"  cpu_arch="${_vals[4]}"  cpu_freq_max="${_vals[5]}"
    ram_total_mb="${_vals[6]}"
    gpu_vendor="${_vals[7]}"  gpu_name="${_vals[8]}"  gpu_driver="${_vals[9]}"

    local btrfs_arr=()
    while IFS= read -r mnt; do
        [[ -n "$mnt" ]] && btrfs_arr+=("$mnt")
    done < <(jq -r '.[] | select(.type=="Disk") | .result[] |
        select(.filesystem=="btrfs") |
        select(.volumeType | contains(["Regular"])) |
        .mountpoint' <<< "$ff" 2>/dev/null || true)
    [[ ${#btrfs_arr[@]} -eq 0 ]] && btrfs_arr=("/")

    local disk_arr=()
    while IFS= read -r dev; do
        [[ -n "$dev" ]] && disk_arr+=("$dev")
    done < <(jq -r '.[] | select(.type=="PhysicalDisk") | .result[] |
        select(.interconnect != "Virtual") |
        select(.devPath | test("^/dev/sr") | not) |
        .devPath' <<< "$ff" 2>/dev/null || true)
    [[ ${#disk_arr[@]} -eq 0 ]] && disk_arr=("/dev/sda")

    local pkg_manager="" aur_helper=""
    has pacman && pkg_manager="pacman"
    has apt    && pkg_manager="apt"
    has dnf    && pkg_manager="dnf"
    has zypper && pkg_manager="zypper"
    has paru   && aur_helper="paru"
    has yay    && [[ -z "$aur_helper" ]] && aur_helper="yay"

    local busy_arr=()
    has steam        && busy_arr+=("steam_app_" "gamescope" "gameoverlayui")
    has wine         && busy_arr+=("wine" "wineserver")
    has lutris       && busy_arr+=("lutris")
    has blender      && busy_arr+=("blender")
    has kdenlive     && busy_arr+=("kdenlive")
    has obs          && busy_arr+=("obs")
    has resolve      && busy_arr+=("resolve" "DaVinciResolve")
    has handbrake    && busy_arr+=("ghb")
    has ffmpeg       && busy_arr+=("ffmpeg")
    has virt-manager && busy_arr+=("qemu-system")

    local country=""
    country=$(curl -sf --max-time 5 https://ipinfo.io/country 2>/dev/null | tr -d '[:space:]' || true)
    if [[ -z "$country" ]]; then
        local tz; tz=$(timedatectl show --property=Timezone --value 2>/dev/null || true)
        case "$tz" in
            Europe/Warsaw*|Europe/Krak*)                              country="Poland" ;;
            Europe/Berlin*|Europe/Hamburg*)                           country="Germany" ;;
            Europe/London*)                                           country="United Kingdom" ;;
            Europe/Paris*)                                            country="France" ;;
            America/New_York*|America/Chicago*|America/Los_Angeles*) country="United States" ;;
        esac
    fi

    {
        printf 'DISTRO_ID="%s"\n'     "$distro_id"
        printf 'DISTRO_NAME="%s"\n'   "$distro_name"
        printf 'PKG_MANAGER="%s"\n'   "$pkg_manager"
        printf 'AUR_HELPER="%s"\n'    "$aur_helper"
        printf 'COUNTRY="%s"\n'       "$country"
        printf 'CPU_MODEL="%s"\n'     "$cpu_model"
        printf 'CPU_CORES="%s"\n'     "$cpu_cores"
        printf 'CPU_ARCH="%s"\n'      "$cpu_arch"
        printf 'CPU_FREQ_MAX="%s"\n'  "$cpu_freq_max"
        printf 'RAM_TOTAL_MB="%s"\n'  "$ram_total_mb"
        printf 'GPU_VENDOR="%s"\n'    "$gpu_vendor"
        printf 'GPU_NAME="%s"\n'      "$gpu_name"
        printf 'GPU_DRIVER="%s"\n'    "$gpu_driver"
        printf 'BTRFS_MOUNTS=(%s)\n'      "$(printf '"%s" ' "${btrfs_arr[@]}")"
        printf 'SMART_DISKS=(%s)\n'       "$(printf '"%s" ' "${disk_arr[@]}")"
        printf 'SCANNED_BUSYPROCS=(%s)\n' "$(printf '"%s" ' "${busy_arr[@]}")"
    } > "$SCAN_FILE"

    # shellcheck source=/dev/null
    source "$SCAN_FILE"

    log "Scan: $distro_name | ${cpu_cores}x ${cpu_model} [${cpu_arch}] ${cpu_freq_max}MHz | RAM ${ram_total_mb}MB"
    log "Scan: GPU ${gpu_vendor} ${gpu_name} | pkg=$pkg_manager aur=$aur_helper country=$country"
    log "Scan: btrfs=${btrfs_arr[*]} | disks=${disk_arr[*]}"
    mark_done scan
}

# ═══════════════════════════════════════════════════════
# main
# ═══════════════════════════════════════════════════════

mkdir -p "$STATE_DIR"
ERR_FILE=$(mktemp "$STATE_DIR/errors.XXXXXX")
trap 'rm -f "$ERR_FILE"' EXIT

[[ -f "$SCAN_FILE" ]] && source "$SCAN_FILE"
rotate_log

ping -c 1 -W 3 archlinux.org &>/dev/null && _NETWORK=1 || _NETWORK=0

log "══ START maintanance ══"

if is_busy; then
    log "Zajęty (gra/praca/load>${MAX_LOAD}) — wychodzę."
    exit 0
fi

if ! is_afk; then
    log "Aktywny (idle < ${AFK_MIN_SECONDS}s) — wychodzę."
    exit 0
fi

log "AFK — uruchamiam zadania..."

task_scan

bg task_time_sync
bg task_mirrors
bg_wait

# backup PRZED update (user: "aktualizacja ma byc po backupie") - plus
# task_update ma teraz realny SNAPSHOT_CMD (btrfs subvolume snapshot -r /
# pre- i post-update pod /snapshots/), wiec jest siatka bezpieczenstwa
# jesli cos sie rozjedzie (konflikt configow, zly kernel, driver nvidia).
task_backup
task_update

bg task_disk_space
bg task_clean_cache
bg task_clean_browsers
bg task_clean_tmp
bg task_clean_logs
bg_wait

task_clean_orphans
task_btrfs_balance
task_btrfs_scrub

task_smart

task_nmap
task_rkhunter

log "══ KONIEC maintanance ══"

ERRORS=()
while IFS= read -r line; do
    [[ -n "$line" ]] && ERRORS+=("$line")
done < "$ERR_FILE"

if [[ "${#ERRORS[@]}" -gt 0 ]]; then
    local_msg=$(printf '• %s\n' "${ERRORS[@]}" | head -5)
    notify critical "$(printf 'Problemy (%d):\n%s\n\nLog: %s' "${#ERRORS[@]}" "$local_msg" "$LOG_FILE")"
    exit 1
fi

exit 0
